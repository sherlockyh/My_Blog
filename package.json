{
  "name": "my-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@my-blog/web",
    "dev:server": "turbo run dev --filter=@my-blog/server",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:up": "docker compose up -d postgres redis minio",
    "db:down": "docker compose down",
    "docker:up": "docker compose up -d --build",
    "db:push": "pnpm --filter @my-blog/server prisma:push",
    "db:migrate:dev": "pnpm --filter @my-blog/server prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @my-blog/server prisma:migrate:deploy",
    "db:seed": "pnpm --filter @my-blog/server seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{less,css,json,md}": [
      "prettier --write"
    ]
  }
}
