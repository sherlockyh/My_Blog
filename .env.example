# docker compose 根环境变量模板：复制为 .env 后按需修改。
#   cp .env.example .env

# 应用入口端口（nginx，前端静态 + API 反代同源）
APP_PORT=8080

# 管理员初始账号（仅 User 表为空时创建；密码不能是 admin123）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# JWT 密钥：生产必须换成足够长的随机值
JWT_SECRET=change-me-to-a-long-random-string

# MinIO 对象存储根账号（密码至少 8 位；9000 是 S3 API 端口，9001 是 Web 控制台）
MINIO_ROOT_USER=blogminio
MINIO_ROOT_PASSWORD=blogminio123

# 上传图片默认同源反代（nginx /uploads/ → MinIO），DB 存相对路径，无需浏览器直连 9000；
# 如需 CDN 等浏览器直连场景，再显式配置 S3_PUBLIC_BASE_URL。

# 前端入口地址（生产启动校验必填；同源部署下用于 CORS 允许列表）
# 开发环境不配置时默认只放行 http://localhost:5173（vite dev server）；
# 若从其他端口访问 dev API（如 vite preview 的 4173），需在此显式配置。
CORS_ORIGIN=http://localhost:8080
